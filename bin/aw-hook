#!/usr/bin/env bash
# Claude Code hook -> Agent Worlds server. Codex, Qwen Code, Kimi Code, Gemini CLI and agy run it too, with their name as $1
# (agy, whose payloads do not name their event, adds the event as $2).
# Reads the hook JSON on stdin and POSTs it with the token. Prints the server's reply
# (a PermissionRequest decision) when there is one. Never fails the Claude session:
# if the server is down, unconfigured, or AGENT_WORLDS_DISABLE=1, it exits 0 silently.
# Stdin is read first, so Claude never writes into a closed pipe.
# The one exception to exiting silently: Gemini (--approval-mode yolo) and agy (--dangerously-skip-permissions)
# run with this hook as the only gate on their tools, so a BeforeTool or PreToolUse that cannot reach the server
# is denied rather than let through.
agent="claude"
[[ "${1:-}" =~ ^[a-z]{1,20}$ ]] && agent="$1"
event=""
[[ "${2:-}" =~ ^[A-Za-z]{1,30}$ ]] && event="$2"
dir=""
[ -n "$event" ] && [[ "${AGENT_WORLDS_DIR:-}" =~ ^/[^[:cntrl:]]{0,4000}$ ]] && dir="$AGENT_WORLDS_DIR"
payload="$(cat)"
gate=""
re='"hook_event_name":[[:space:]]*"BeforeTool"'
[ "$agent" = gemini ] && [[ "$payload" =~ $re ]] && gate=1
[ "$agent" = agy ] && [ "$event" = PreToolUse ] && gate=1
quit() {
  [ -n "$gate" ] && printf '%s\n' '{"decision":"deny","reason":"Agent Worlds could not be reached to approve this tool, so it did not run."}'
  exit 0
}
[ "${AGENT_WORLDS_DISABLE:-}" = "1" ] && quit
home="${AGENT_WORLDS_HOME:-$HOME/.config/agent-worlds}"
[ -r "$home/endpoint" ] && [ -r "$home/token" ] || quit
command -v curl >/dev/null 2>&1 || quit
url="$(head -n1 "$home/endpoint")"
token="$(head -n1 "$home/token")"
max=2
re='"hook_event_name":[[:space:]]*"(PermissionRequest|BeforeTool|SessionEnd)"'
if [[ "$payload" =~ $re ]]; then
  # PermissionRequest (and Gemini's BeforeTool) is held until the GUI decides (the server gives up at 3540 s, the hook timeout is 3600 s).
  [ "${BASH_REMATCH[1]}" = SessionEnd ] && max=1 || max=3590
fi
[ -n "$gate" ] && max=3590
pane=""
[[ "${TMUX_PANE:-}" =~ ^%[0-9]+$ ]] && pane="$TMUX_PANE"
# A session the server runs itself (no tmux) carries its pty name instead.
pty=""
[[ "${AGENT_WORLDS_PTY:-}" =~ ^[A-Za-z0-9_-]{1,100}$ ]] && pty="$AGENT_WORLDS_PTY"
# Headers come from a process substitution so the token never appears in `ps`.
out="$(printf '%s' "$payload" | curl -sS --fail --connect-timeout 1 --max-time "$max" \
  -H @<(printf 'X-AW-Token: %s\nX-AW-Pane: %s\nX-AW-Pty: %s\nX-AW-Agent: %s\nX-AW-Event: %s\nX-AW-Dir: %s\nContent-Type: application/json\n' "$token" "$pane" "$pty" "$agent" "$event" "$dir") \
  --data-binary @- "$url/api/hook" 2>/dev/null)" || quit
[ -n "$out" ] && printf '%s\n' "$out"
exit 0
