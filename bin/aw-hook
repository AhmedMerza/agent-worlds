#!/usr/bin/env bash
# Claude Code hook -> Agent Worlds server. Codex and Qwen Code run it too, with their name as $1.
# Reads the hook JSON on stdin and POSTs it with the token. Prints the server's reply
# (a PermissionRequest decision) when there is one. Never fails the Claude session:
# if the server is down, unconfigured, or AGENT_WORLDS_DISABLE=1, it exits 0 silently.
# Early exits still read stdin, so Claude never writes into a closed pipe.
quit() { cat >/dev/null; exit 0; }
[ "${AGENT_WORLDS_DISABLE:-}" = "1" ] && quit
home="${AGENT_WORLDS_HOME:-$HOME/.config/agent-worlds}"
[ -r "$home/endpoint" ] && [ -r "$home/token" ] || quit
command -v curl >/dev/null 2>&1 || quit
url="$(head -n1 "$home/endpoint")"
token="$(head -n1 "$home/token")"
payload="$(cat)"
max=2
re='"hook_event_name":[[:space:]]*"(PermissionRequest|SessionEnd)"'
if [[ "$payload" =~ $re ]]; then
  # PermissionRequest is held until the GUI decides (the server gives up at 3540 s, the hook timeout is 3600 s).
  [ "${BASH_REMATCH[1]}" = PermissionRequest ] && max=3590 || max=1
fi
pane=""
[[ "${TMUX_PANE:-}" =~ ^%[0-9]+$ ]] && pane="$TMUX_PANE"
# A session the server runs itself (no tmux) carries its pty name instead.
agent="claude"
[[ "${1:-}" =~ ^[a-z]{1,20}$ ]] && agent="$1"
pty=""
[[ "${AGENT_WORLDS_PTY:-}" =~ ^[A-Za-z0-9_-]{1,100}$ ]] && pty="$AGENT_WORLDS_PTY"
# Headers come from a process substitution so the token never appears in `ps`.
out="$(printf '%s' "$payload" | curl -sS --fail --connect-timeout 1 --max-time "$max" \
  -H @<(printf 'X-AW-Token: %s\nX-AW-Pane: %s\nX-AW-Pty: %s\nX-AW-Agent: %s\nContent-Type: application/json\n' "$token" "$pane" "$pty" "$agent") \
  --data-binary @- "$url/api/hook" 2>/dev/null)" || exit 0
[ -n "$out" ] && printf '%s\n' "$out"
exit 0
