#!/usr/bin/env bash
# MCP server (stdio) that sessions Agent Worlds starts use to message each other: each JSON-RPC line
# from the agent CLI goes to the server's /mcp with the token and the pane it runs in, which tells the
# server who is speaking. The reply, if any, is printed back. $1 names the agent CLI.
# If the server is down, a request gets a JSON-RPC error instead of hanging the CLI.
[ "${AGENT_WORLDS_DISABLE:-}" = "1" ] && exit 0
home="${AGENT_WORLDS_HOME:-$HOME/.config/agent-worlds}"
command -v curl >/dev/null 2>&1 || exit 0
pane=""
[[ "${TMUX_PANE:-}" =~ ^%[0-9]+$ ]] && pane="$TMUX_PANE"
pty=""
[[ "${AGENT_WORLDS_PTY:-}" =~ ^[A-Za-z0-9_-]{1,100}$ ]] && pty="$AGENT_WORLDS_PTY"
agent="claude"
[[ "${1:-}" =~ ^[a-z]{1,20}$ ]] && agent="$1"
id_re='"id"[[:space:]]*:[[:space:]]*("([^"\\]|\\.)*"|-?[0-9]+)'
while IFS= read -r line || [ -n "$line" ]; do
  [ -z "$line" ] && continue
  # Read per line: a restarted server may listen elsewhere.
  url="$(head -n1 "$home/endpoint" 2>/dev/null)"
  token="$(head -n1 "$home/token" 2>/dev/null)"
  # Headers come from a process substitution so the token never appears in `ps`.
  if out="$(printf '%s' "$line" | curl -sS --fail --connect-timeout 1 --max-time 30 \
    -H @<(printf 'X-AW-Token: %s\nX-AW-Pane: %s\nX-AW-Pty: %s\nX-AW-Agent: %s\nContent-Type: application/json\n' "$token" "$pane" "$pty" "$agent") \
    --data-binary @- "$url/mcp" 2>/dev/null)"; then
    [ -n "$out" ] && printf '%s\n' "$out"
  elif [[ "$line" =~ $id_re ]]; then
    printf '{"jsonrpc":"2.0","id":%s,"error":{"code":-32000,"message":"Agent Worlds is not running"}}\n' "${BASH_REMATCH[1]}"
  fi
done
